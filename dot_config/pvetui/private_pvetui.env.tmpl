# pvetui API token credentials — injected at runtime via 1Password.
# Loaded by the `pvetui` shell alias / sesh startup_command: `op run --env-file=... -- pvetui`.
# The "token id" field may hold the full "root@pam!doublestrike" — pvetui uses it
# as-is and builds the correct PVEAPIToken header (verified). Both values stay
# op:// references, resolved at runtime so the secret never lands on disk.
PVETUI_TOKEN_ID="op://{{ .pvetui.vault }}/{{ .pvetui.item }}/token id"
PVETUI_TOKEN_SECRET="op://{{ .pvetui.vault }}/{{ .pvetui.item }}/token api secret"
